# Copy to .env.gallery and fill in real values. .env.gallery is gitignored.
#
# SUPABASE_URL / SUPABASE_ANON_KEY are intentionally public: the anon key is
# shipped to the browser in gallery-config.js and is only safe because Row
# Level Security restricts what it can do. Never put a service_role key here —
# it bypasses RLS entirely.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<publishable-or-anon-key>

# Admin login for tools/seed-gallery.mjs and the admin dashboard.
# This account is the only one allowed to write to the gallery (enforced by
# public.is_gallery_admin() in the database policies).
GALLERY_ADMIN_EMAIL=
GALLERY_ADMIN_PASSWORD=

# Optional, defaults to gallery-images
GALLERY_BUCKET=gallery-images
